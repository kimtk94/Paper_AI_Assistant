{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea_record.schema.json",
  "title": "Multi-omics Research Idea Record",
  "type": "object",
  "required": [
    "idea_id",
    "title",
    "disease_domain",
    "disease_name",
    "hypothesis",
    "target_modalities",
    "rationale",
    "supporting_papers",
    "required_datasets",
    "analysis_plan",
    "evaluation_metrics",
    "risk_and_fallback",
    "scores",
    "priority_rank"
  ],
  "properties": {
    "idea_id": { "type": "string" },
    "title": { "type": "string" },
    "disease_domain": {
      "type": "string",
      "enum": ["metabolic", "brain"]
    },
    "disease_name": {
      "type": "string",
      "enum": [
        "type_2_diabetes",
        "obesity",
        "nafld",
        "metabolic_syndrome",
        "alzheimers_disease",
        "parkinsons_disease",
        "schizophrenia",
        "major_depressive_disorder"
      ]
    },
    "hypothesis": { "type": "string" },
    "target_modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["GWAS", "TWAS", "PWAS", "scRNA_seq", "eQTL", "pQTL", "ATAC_seq"]
      },
      "minItems": 2
    },
    "rationale": {
      "type": "object",
      "required": ["gap_statement", "biological_plausibility", "novelty_statement"],
      "properties": {
        "gap_statement": { "type": "string" },
        "biological_plausibility": { "type": "string" },
        "novelty_statement": { "type": "string" }
      },
      "additionalProperties": false
    },
    "supporting_papers": {
      "type": "array",
      "items": { "type": "string", "description": "paper_id references" },
      "minItems": 1
    },
    "required_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "modality", "access"],
        "properties": {
          "name": { "type": "string" },
          "modality": { "type": "string" },
          "access": { "type": "string", "enum": ["open", "controlled", "unknown"] },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "analysis_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "description"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "tool_hint": { "type": "string" }
        },
        "additionalProperties": false
      },
      "minItems": 3
    },
    "evaluation_metrics": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "risk_and_fallback": {
      "type": "object",
      "required": ["main_risks", "fallback_plan"],
      "properties": {
        "main_risks": { "type": "array", "items": { "type": "string" } },
        "fallback_plan": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": ["novelty", "feasibility", "impact", "overall"],
      "properties": {
        "novelty": { "type": "number", "minimum": 0, "maximum": 10 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 10 },
        "impact": { "type": "number", "minimum": 0, "maximum": 10 },
        "overall": { "type": "number", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "priority_rank": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
